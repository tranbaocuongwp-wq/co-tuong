# Dependencies and build output
node_modules/
dist/
target/
.vite/

# wasm-pack output — generated from engine-wasm/ on every build
src/wasm/

# Local databases and engine memory
*.db
*.db-shm
*.db-wal

# Tauri generated schemas
src-tauri/gen/schemas/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local secrets — never commit Cloudflare tokens
.env
.env.local
.dev.vars

# Wrangler local dev state (miniflare caches, local R2/D1 copies)
worker/.wrangler/

# Hồ sơ Chrome tạm của scripts/store-shots.mjs
store-shots/.chrome-profile/
