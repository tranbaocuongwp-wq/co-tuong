{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Đệ Nhất Cờ Tướng",
  "version": "0.8.0",
  "identifier": "com.tranbaocuong.cotuong",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Đệ Nhất Cờ Tướng",
        "width": 1100,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Cờ Tướng offline",
    "longDescription": "Cờ Tướng chơi hoàn toàn ngoại tuyến, engine viết bằng Rust, có chế độ siêu khó và lưu lịch sử ván đấu.",
    "copyright": "© 2026 Trần Bảo Cường. MIT License.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
